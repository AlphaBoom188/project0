# Supabase Configuration
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_URL=https://your-project.supabase.co
# This backend is a trusted server and talks to Supabase with the service role
# key (bypasses RLS; per-user access control is enforced in the controllers).
# Keep this secret -- never ship it to the iOS app or any client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Not currently used by this backend; kept for any future client-side usage.
SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key

# LINE Login Configuration
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id
LINE_LOGIN_CHANNEL_SECRET=your_line_login_channel_secret
LINE_LOGIN_REDIRECT_URI=http://localhost:3000/api/line/callback

# LINE Messaging API Configuration
LINE_MESSAGING_CHANNEL_ID=your_line_messaging_channel_id
LINE_MESSAGING_CHANNEL_SECRET=your_line_messaging_channel_secret
# Long-lived channel access token (issued separately from the secret, in the
# LINE Developers Console) -- required to send reply/push messages.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=your_line_messaging_channel_access_token
# Webhook endpoint to register in the LINE Developers Console:
#   https://<your-public-domain>/api/line/webhook

# LIFF (LINE MINI App) Configuration
# Create under the Messaging API channel's LIFF tab, with Endpoint URL:
#   https://<your-public-domain>/liff/
LIFF_ID=your_liff_id

# Server Configuration
PORT=3000
NODE_ENV=development
