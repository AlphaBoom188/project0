# Supabase Configuration
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_URL=https://your-project.supabase.co
# This backend is a trusted server and talks to Supabase with the service role
# key (bypasses RLS; per-user access control is enforced in the controllers).
# Keep this secret -- never ship it to the iOS app or any client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Not currently used by this backend; kept for any future client-side usage.
SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key

# LINE Login Configuration
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id
LINE_LOGIN_CHANNEL_SECRET=your_line_login_channel_secret
LINE_LOGIN_REDIRECT_URI=http://localhost:3000/api/line/callback

# LINE Messaging API Configuration
LINE_MESSAGING_CHANNEL_ID=your_line_messaging_channel_id
LINE_MESSAGING_CHANNEL_SECRET=your_line_messaging_channel_secret
# Long-lived channel access token (issued separately from the secret, in the
# LINE Developers Console) -- required to send reply/push messages.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=your_line_messaging_channel_access_token
# Webhook endpoint to register in the LINE Developers Console:
#   https://<your-public-domain>/api/line/webhook

# LIFF (LINE MINI App) Configuration
# Create under the Messaging API channel's LIFF tab, with Endpoint URL:
#   https://<your-public-domain>/liff/
LIFF_ID=your_liff_id

# Email export relay (Google Apps Script Web App) -- see
# docs/APPS_SCRIPT_EMAIL_RELAY.md for the script to deploy and where these
# two values come from. Without these set, the "email CSV" feature returns a
# clear 501 rather than silently failing.
APPS_SCRIPT_EMAIL_WEBHOOK_URL=your_apps_script_web_app_url
APPS_SCRIPT_SHARED_SECRET=your_own_random_secret_string

# Google OAuth -- NOT a login/identity method (LINE Login stays the only way
# into the app). Used only to get a verified email for CSV export, replacing
# the free-text email field. Create an OAuth 2.0 Client ID (type: Web
# application) at https://console.cloud.google.com/apis/credentials, add the
# redirect URI below to its "Authorized redirect URIs", and enable the
# "Google People API" (or just the default OpenID Connect scopes) on the
# project. Without these set, "Connect Google" returns a clear 501.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback

# Server Configuration
PORT=3000
NODE_ENV=development
